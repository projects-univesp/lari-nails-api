# Application
NODE_ENV=development
PORT=3000

# Security
CORS_ORIGIN=
AUTOMATION_API_KEY=
AUTOMATION_EVENT_WEBHOOK_URL=
AUTOMATION_EVENT_WEBHOOK_SECRET=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Docker & Deployment
IMAGE_NAME=lari-nails-api
VERSION=latest

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lari_nails_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lari_nails_db?schema=public
